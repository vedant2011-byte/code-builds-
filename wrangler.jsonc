{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "code-builts",
  "main": "worker/dist/index.js",
  "compatibility_date": "2026-11-01",

  // The site and the API are one Worker: /api/* is handled in code, everything
  // else is served from the Vite build in dist/.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "none"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "code-builts-arcade",
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "migrations"
    }
  ],

  "observability": {
    "enabled": true
  },

  "vars": {
    "ENVIRONMENT": "development"
  }
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "code-builts",
  "main": "worker/dist/index.js",
  "compatibility_date": "2026-11-01",

  // The site and the API are one Worker: /api/* is handled in code, everything
  // else is served from the Vite build in dist/.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "none"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "code-builts-arcade",
      "database_id": "c1ca306a-f9e1-4edc-9721-88fc91bcea4a",
      "migrations_dir": "migrations"
    }
  ],

  "observability": {
    "enabled": true
  },

  "vars": {
    "ENVIRONMENT": "production",
    // Origins allowed to call the API (comma separated). Local values live in
    // .dev.vars and override this during `wrangler dev`.
    "APP_ORIGIN": "https://codebuilds.vercel.app,https://code-builts.codebuilds.workers.dev"
  }
}
